# Point the app at a local Factfulness API (omit to use offline LocalRepository + seed data).
# Android emulator → host machine:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# iOS simulator:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# Physical device on same LAN → your PC IP, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
EXPO_PUBLIC_API_URL=

# Supabase Auth (optional — omit both to use dev headers against AUTH_MODE=dev backend)
# Project URL: Supabase Dashboard → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=
# anon public key (same API settings page)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
