# Copy to backend/.env for local runs (no real secrets)
DATABASE_URL=postgresql+psycopg://factfulness:factfulness@localhost:5432/factfulness
API_PREFIX=/v1
CORS_ORIGINS=*

AUTH_MODE=dev
DEV_USER_EXTERNAL_ID=dev-local-user
DEV_USER_DISPLAY_NAME=dev

SUPABASE_URL=
# Legacy HS256 JWT secret (optional if using JWKS signing keys only)
SUPABASE_JWT_SECRET=

# fake = log only (pytest/CI) | expo = POST to Expo Push API
PUSH_SENDER=fake
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

REPORT_AUTO_HIDE_THRESHOLD=3

# --- Phase 1 file evidence ---
# memory = in-process (pytest default) | filesystem = /tmp paths | s3 = R2 or MinIO
STORAGE_BACKEND=filesystem
FILESYSTEM_STORAGE_ROOT=/tmp/factfulness-storage

# MinIO (docker compose) or Cloudflare R2 (production)
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=auto
S3_QUARANTINE_BUCKET=factfulness-quarantine
S3_CLEAN_BUCKET=factfulness-evidence

PRESIGNED_UPLOAD_TTL_SECONDS=900
PRESIGNED_DOWNLOAD_TTL_SECONDS=900
MAX_EVIDENCE_FILE_BYTES=10485760

# fake = EICAR test bytes | clamd = TCP clamd (docker compose clamav service)
SCANNER_BACKEND=fake
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Rate limits (mirror mobile/src/config/rateLimits.ts)
RATE_FILE_UPLOAD_PER_USER_PER_HOUR=30
RATE_EVIDENCE_CREATE_PER_USER_PER_HOUR=30

# Real Cloudflare R2 (when ready — create two buckets, API token Object Read & Write):
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_QUARANTINE_BUCKET=factfulness-quarantine
# S3_CLEAN_BUCKET=factfulness-evidence
