# Copy to backend/.env for local runs (no real secrets)
DATABASE_URL=postgresql+psycopg://factfulness:factfulness@localhost:5432/factfulness
API_PREFIX=/v1
CORS_ORIGINS=*

# dev = auto local user for writes; supabase = require Bearer JWT
AUTH_MODE=dev
DEV_USER_EXTERNAL_ID=dev-local-user
DEV_USER_DISPLAY_NAME=dev
# Mobile API mode sends X-Dev-User-External-Id / X-Dev-Display-Name (nickname profile).

# Required only when AUTH_MODE=supabase (JWT secret from Supabase project settings)
SUPABASE_URL=
SUPABASE_JWT_SECRET=

REPORT_AUTO_HIDE_THRESHOLD=3
